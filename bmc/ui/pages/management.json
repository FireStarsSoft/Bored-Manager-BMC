                    {
                      "type": "conditional",
                      "when": {
                        "source": {
                          "kind": "stream",
                          "event": "ui",
                          "path": "hintsOn"
                        },
                        "op": "eq",
                        "value": true
                      },
                      "blocks": [
                        {
                          "type": "note",
                          "title": "What lands on these charts",
                          "lines": [
                            "One point per sweep: how many machines were on, off, unreachable or refusing the saved credentials, and how many sensors across the whole fleet were reporting a warning or a critical state.",
                            "How often a sweep runs is the BMC slow interval, in the app's own Settings under Update intervals. How often sensors are re-read on top of that is a rule on the Module settings page."
                          ]
                        }
                      ]
                    },
                    {
                      "type": "conditional",
                      "when": {
                        "source": {
