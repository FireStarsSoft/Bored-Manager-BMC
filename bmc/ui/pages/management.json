                                {
                                  "type": "conditional",
                                  "when": {
                                    "source": {
                                      "kind": "stream",
                                      "event": "ui",
                                      "path": "hintsOn"
                                    },
                                    "op": "eq",
                                    "value": true
                                  },
                                  "blocks": [
                                    {
                                      "type": "note",
                                      "title": "What this opens",
                                      "lines": [
                                        "An IPMI Serial-over-LAN session: the machine's serial console, over the network, through its BMC. It shows the boot messages and a login prompt whether or not the operating system has a network of its own - which is what makes it worth having when nothing else can reach the machine.",
                                        "It is a real shell in the app's terminal list and outlives this drawer, so closing the card does not end the session. Type the escape sequence (usually ~. ) to leave it, or close it from the Terminals page.",
                                        "A BMC allows one serial session at a time. If it says the session is already in use, something else - or somebody else - has it."
                                      ]
                                    }
                                  ]
                                }
                              ]
