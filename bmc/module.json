{
  "apiVersion": 2,
  "id": "bmc",
  "name": "BMC",
  "version": "2.0.0",
  "description": "Control server mainboards out-of-band through their BMC using IPMI over LAN: fleet sensor health, power, event log and boot device, with credentials kept encrypted.",
  "author": "Bored Manager",
  "minAppVersion": "0.6.0",
  "defaultEnabled": false,
  "entries": {
    "main": "main/index.ts"
  },
  "pages": [
    {
      "id": "management",
      "label": "Management",
      "icon": "Server",
      "order": 55
    },
    {
      "id": "settings",
      "label": "Module settings",
      "icon": "Settings2",
      "order": 56
    }
  ],
  "widgets": [
    {
      "id": "summary",
      "label": "BMC fleet health",
      "defaultEnabled": false,
      "order": 76
    }
  ],
  "streams": [
    {
      "event": "machines",
      "kind": "latest"
    },
    {
      "event": "series",
      "kind": "series"
    },
    {
      "event": "capabilities",
      "kind": "latest"
    },
    {
      "event": "overview",
      "kind": "latest"
    },
    {
      "event": "ui",
      "kind": "latest"
    }
  ],
  "methods": [
    "machineRows",
    "machineCheck",
    "machineApply",
    "machineDelete",
    "machineTest",
    "machineEnable",
    "machineInspect",
    "sensorRows",
    "selRows",
    "attentionRows",
    "incidentRows",
    "powerAction",
    "selClear",
    "powerBulk",
    "solCommand",
    "bootDevSet",
    "identify",
    "sweepNow",
    "rulesEffective",
    "rulesCheck",
    "rulesApply",
    "rulesReset",
    "hintsSet"
  ],
  "storage": {
    "config": {
      "maxKB": 512
    },
    "secrets": {
      "maxEntries": 64
    },
    "history": {
      "streams": [
        "bmc"
      ],
      "maxMB": 32
    },
    "records": [
      {
        "id": "incidents",
        "label": "When each machine changed",
        "maxMB": 32,
        "retentionDays": 180,
        "overflow": "evict-oldest"
      }
    ]
  },
  "fastInterval": "bmc",
  "slowInterval": "bmc"
}
