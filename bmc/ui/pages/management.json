{
  "blocks": [
    {
      "type": "conditional",
      "when": {
        "source": {
          "kind": "stream",
          "event": "capabilities",
          "path": "state"
        },
        "op": "eq",
        "value": "connecting"
      },
      "blocks": [
        {
          "type": "note",
          "title": "Waiting for a machine",
          "lines": [
            "This module runs ipmitool on the machine the app is connected to, and speaks IPMI over LAN from there to each BMC you saved.",
            "Connect to a machine in the sidebar and this page fills in by itself. Machines you saved earlier are kept and start being swept again as soon as a connection is back."
          ]
        }
      ],
      "else": [
        {
          "type": "conditional",
          "when": {
            "source": {
              "kind": "stream",
              "event": "capabilities",
              "path": "state"
            },
            "op": "eq",
            "value": "blocked"
          },
          "blocks": [
            {
              "type": "section",
              "title": "BMC control is not ready",
              "blocks": [
                {
                  "type": "keyValue",
                  "source": {
                    "kind": "stream",
                    "event": "capabilities"
                  },
                  "rows": [
                    {
                      "key": "stateLabel",
                      "label": "Status"
                    },
                    {
                      "key": "ipmitool",
                      "label": "ipmitool"
                    },
                    {
                      "key": "problem",
                      "label": "Problem"
                    }
                  ]
                },
                {
                  "type": "note",
                  "title": "Nothing is being swept",
                  "tone": "warning",
                  "lines": [
                    "The machines you saved are kept, and none of them can be reached until the problem above is fixed on the connected machine."
                  ]
                },
                {
                  "type": "actions",
                  "actions": [
                    {
                      "label": "Look again",
                      "method": "sweepNow"
                    }
                  ]
                }
              ]
            }
          ],
          "else": [
            {
              "type": "conditional",
              "when": {
                "source": {
                  "kind": "stream",
                  "event": "capabilities",
                  "path": "state"
                },
                "op": "eq",
                "value": "checking"
              },
              "blocks": [
                {
                  "type": "note",
                  "title": "Checking the connected machine",
                  "lines": [
                    "Making sure ipmitool is there before asking any BMC anything. Cards below fill in as answers arrive; a machine still reading \"Not checked yet\" simply has not answered yet."
                  ]
                }
              ]
            },
            {
              "type": "note",
              "title": "Nothing is being swept",
              "tone": "warning",
              "lines": [
                "ipmitool works here, and no machine is switched on for sweeping. Add one on the Module settings page, or resume a machine you parked there."
              ]
            },
